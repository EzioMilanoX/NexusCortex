# Ambientes virtuais — NUNCA versionar nem compartilhar entre SOs.
# O venv criado no Windows não funciona no Linux (e vice-versa):
# crie um em cada sistema (instruções no README.md).
.venv*/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Saídas geradas pelos agentes
output/*.txt

# Episódios do Estúdio de Podcast — um programa de 15 min passa de 40 MB em
# WAV; nada disso pode entrar no histórico do git.
output/podcast/

# Revisões semanais (recap.py) e críticas (critica.py) — saídas pessoais.
output/recap/
output/critica/

# Vozes do Piper (~63 MB cada .onnx). São baixadas sob demanda com
# 'python -m piper.download_voices' — ver README.
vozes/

# Segredos / configuração local
.env

# IDEs
.vscode/
.idea/

# Config local de ferramentas de IA
.claude/
